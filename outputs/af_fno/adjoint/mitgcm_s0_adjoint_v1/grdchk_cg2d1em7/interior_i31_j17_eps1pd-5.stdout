(PID.TID 0000.0001) ># AF--FNO adjoint optimisation cycle.
(PID.TID 0000.0001) >#
(PID.TID 0000.0001) ># optimcycle = 0 fixes the control filename to xx_etan.0000000000.data and the
(PID.TID 0000.0001) ># gradient to adxx_etan.0000000000.data.  There is no optimisation here: this
(PID.TID 0000.0001) ># is a pure sensitivity calculation, one cycle only.
(PID.TID 0000.0001) > &OPTIM
(PID.TID 0000.0001) > optimcycle = 0,
(PID.TID 0000.0001) > /
(PID.TID 0000.0001) 
