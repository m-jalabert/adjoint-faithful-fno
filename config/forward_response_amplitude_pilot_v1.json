  "response_quantities": {
    "external_normalization": "exact_parent_pointwise_state_normalizer",
    "oriented_raw_response": "R_q_k_s=(N(M_k(x+s*alpha*v))-N(M_k(x)))/s",
    "differentiated_response": "r_q_k_s=R_q_k_s/alpha",
    "group_balanced_norm_squared": "norm_GB(z)^2=(1/4)*sum_{g in U,V,Theta,SSH} mean_{c in g,wet}(z_c^2)",
    "q_lin": "norm_GB(R_plus-R_minus)/(0.5*(norm_GB(R_plus)+norm_GB(R_minus)))",
    "q_snr": "0.5*(norm_GB(R_plus)+norm_GB(R_minus))/n_raw_family_GB_lead",
    "centred_jvp": "Jhat_alpha=(N(M(x+alpha*v))-N(M(x-alpha*v)))/(2*alpha)",
    "adjacent_alpha_score": "norm_GB(Jhat_alpha-Jhat_smaller)/max(norm_GB(Jhat_smaller),n_diff_family_GB_lead(smaller_alpha))",
    "q_repeat": "norm_GB(R_production-R_duplicate)/max(0.5*(norm_GB(R_production)+norm_GB(R_duplicate)),n_raw_nominal_GB_lead)",
    "q_cg": "norm_GB(R_production-R_tight)/max(0.5*(norm_GB(R_production)+norm_GB(R_tight)),n_raw_nominal_GB_lead)",
    "raw_and_differentiated_units_must_not_be_pooled": true
  },
  "selection": {
    "per_input_family": true,
    "candidate_order": "largest_to_smallest",
    "rule": "select_the_provisional_largest_candidate_then_retain_it_only_if_all_final_controls_pass",
